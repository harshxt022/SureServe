# Server configuration
PORT=5000

# Database connection string (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sureserve?schema=public"

# Authentication
JWT_SECRET="replace_with_a_long_random_secure_string"
JWT_EXPIRES_IN=7d

# CORS / Socket.io Authorized Client URL (Vercel Frontend URL)
CLIENT_URL="http://localhost:5173"

# Business logic config
BOOKING_EXPIRY_MINUTES=15
DEFAULT_TIMEZONE="Asia/Kolkata"

# Razorpay credentials (if omitted, will fall back to test sandbox credentials)
RZP_KEY_ID="your_razorpay_key_id"
RZP_KEY_SECRET="your_razorpay_key_secret"
